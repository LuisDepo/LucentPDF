<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- App NO sandboxed: distribución fuera de la App Store. Permite acceso
	     completo a archivos (carpetas elegidas por el usuario) y ejecutar el
	     binario auxiliar de Tesseract embebido sin servicios XPC.
	     Si en el futuro se publica en la App Store, activar el sandbox aquí. -->
	<key>com.apple.security.app-sandbox</key>
	<false/>
</dict>
</plist>
